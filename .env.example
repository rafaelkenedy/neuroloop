# Modelo de configuração. Copie para .env e ajuste.
#
#   cp .env.example .env
#
# Todas as variáveis abaixo têm padrão no código; nenhuma é obrigatória para
# rodar a suíte de testes. Valores aqui são placeholders — não use credenciais
# reais neste arquivo, que é versionado.

# URL do banco usada pelo runtime e pelas migrations.
# Lida em src/neuroloop/persistence/session.py.
# Padrão do código: postgresql+psycopg://neuroloop:neuroloop@localhost:5432/neuroloop
# (as credenciais correspondem ao serviço do docker-compose.yml).
NEUROLOOP_DATABASE_URL=postgresql+psycopg://neuroloop:neuroloop@localhost:5432/neuroloop

# Aponta a suíte de testes para um banco real. Lida apenas pelos testes.
# Se não for definida, cada teste usa um SQLite em arquivo temporário.
# NEUROLOOP_TEST_DATABASE_URL=postgresql+psycopg://neuroloop:neuroloop@localhost:5432/neuroloop

# Execuções por benchmark B1-B5. O padrão de 3 mantém a suíte rápida;
# 30 é o valor com que os intervalos de confiança foram medidos.
# NEUROLOOP_BENCH_SEEDS=3

# Servidor OpenAI-compatível local. Lidas apenas por
# scripts/live_local_model.py; o adapter em si recebe os valores por parâmetro.
# Sem elas o script usa os padrões do LM Studio.
# A chave é ignorada por servidor local, mas o header precisa existir.
# NEUROLOOP_LOCAL_BASE_URL=http://localhost:1234/v1
# NEUROLOOP_LOCAL_API_KEY=chave-ignorada-pelo-servidor-local

# Credencial do provider de LLM, necessária apenas com o extra opcional [llm].
# O código chama anthropic.AsyncAnthropic() sem argumentos, então quem resolve
# a credencial é o próprio SDK. Nenhum teste do repositório usa este caminho.
# ANTHROPIC_API_KEY=sk-ant-EXEMPLO-NAO-USE
